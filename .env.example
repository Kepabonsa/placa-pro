# Copia este archivo como .env.local y ajusta los valores. Nunca commitees .env.local.

# Proveedor de datos vehiculares: mock (Iteración 1) | placapi (Iteración 2)
VEHICLE_PROVIDER=mock
# Latencia simulada del proveedor mock, en milisegundos
MOCK_PROVIDER_LATENCY_MS=600

# Persistencia: memory (Iteración 1, modo demo sin Supabase) | supabase (Iteración 2)
DATA_SOURCE=memory

# PlacApi (Iteración 2)
PLACAPI_BASE_URL=
PLACAPI_API_KEY=
PLACAPI_TIMEOUT_MS=45000

# Supabase (Iteración 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
